<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <IsPackable>false</IsPackable>
    <IsTestProject>true</IsTestProject>

    <!-- xUnit v3 test projects are executables running on Microsoft.Testing.Platform -->
    <OutputType>Exe</OutputType>

    <!-- Credentials are read from user secrets / environment variables, see README.md -->
    <UserSecretsId>gt-connect-management-demo</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Bogus" Version="35.6.5" />
    <PackageReference Include="Gridify" Version="2.20.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.Binder" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.EnvironmentVariables" Version="11.0.0" />
    <PackageReference Include="Microsoft.Extensions.Configuration.UserSecrets" Version="11.0.0" />
    <PackageReference Include="coverlet.MTP" Version="10.1.0" />
    <PackageReference Include="Refit" Version="16.4.0" />
    <PackageReference Include="Riok.Mapperly" Version="4.3.1" />
    <PackageReference Include="xunit.v3" Version="4.0.3" />
  </ItemGroup>

  <ItemGroup>
    <None Update="Resources\background.jpg" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
